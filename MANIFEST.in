# Keep operator-only and local material out of built distributions.
# setuptools packages from the working directory, not from git — .gitignore
# does not apply here.

exclude .env .env.* *.log

# Local credentials
exclude MCP_Server/config.py
prune supabase
prune tests
# Operator-only tooling: needs the service_role key, never ships to users
prune tools_operator
global-exclude *.jsonl
prune dist
prune .venv
prune __pycache__
global-exclude *.py[cod] .DS_Store
exclude DATA_COLLECTION.md
